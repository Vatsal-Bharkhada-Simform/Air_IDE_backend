// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// User — Registered accounts with hashed passwords
// ──────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  sessions     Session[]              // Sessions this user created
  participants SessionParticipant[]   // Sessions this user joined

  @@map("users")
}

// ──────────────────────────────────────────────
// Session — A collaboration room that holds files
// ──────────────────────────────────────────────
model Session {
  id         String   @id @default(uuid())
  name       String                           // Human-friendly name, e.g. "My Project"
  inviteCode String   @unique @map("invite_code") // Short unique code for sharing URLs
  createdBy  String   @map("created_by")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  creator      User                 @relation(fields: [createdBy], references: [id])
  files        SessionFile[]
  participants SessionParticipant[]

  @@map("sessions")
}

// ──────────────────────────────────────────────
// SessionFile — Individual files within a session
// Each session can have multiple files (like tabs in an editor)
// ──────────────────────────────────────────────
model SessionFile {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  filename  String                             // e.g. "index.js", "styles.css"
  content   String   @default("") @db.Text     // Full file content stored as text
  yjsState  Bytes?   @map("yjs_state")         // Yjs binary state
  language  String   @default("plaintext")     // Language hint for syntax highlighting
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // A file name must be unique within a session
  @@unique([sessionId, filename])
  @@map("session_files")
}

// ──────────────────────────────────────────────
// SessionParticipant — Tracks who joined which session
// Used as an audit trail (join/leave times)
// ──────────────────────────────────────────────
model SessionParticipant {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  userId    String    @map("user_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("session_participants")
}

// ──────────────────────────────────────────────
// BlockedToken — JWT blocklist for logout support
// Tokens are stored here on logout and checked during auth
// Expired entries can be cleaned up via a periodic job
// ──────────────────────────────────────────────
model BlockedToken {
  id        String   @id @default(uuid())
  jti       String   @unique              // JWT ID claim
  expiresAt DateTime @map("expires_at")   // When the original token expires
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_tokens")
}
